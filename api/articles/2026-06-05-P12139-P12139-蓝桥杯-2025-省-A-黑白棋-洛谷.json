n class=\"line\">99</span><br><span class=\"line\">100</span><br><span class=\"line\">101</span><br><span class=\"line\">102</span><br><span class=\"line\">103</span><br></pre></td><td class=\"code\"><pre><span class=\"line\"><span class=\"comment\"># 初始棋盘 (-1 表示空)</span></span><br><span class=\"line\">board = [</span><br><span class=\"line\">    [<span class=\"number\">1</span>, <span class=\"number\">0</span>, -<span class=\"number\">1</span>, <span class=\"number\">0</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">0</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">0</span>, <span class=\"number\">0</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">1</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, <span class=\"number\">0</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">1</span>, -<span class=\"number\">1</span>]</span><br><span class=\"line\">]</span><br><span class=\"line\"></span><br><span class=\"line\">n = <span class=\"number\">6</span></span><br><span class=\"line\">empties = [(i, j) <span class=\"keyword\">for</span> i <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">for</span> j <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[i][j] == -<span class=\"number\">1</span>]</span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">count_row</span>(<span class=\"params\">r</span>):</span><br><span class=\"line\">    ones = <span class=\"built_in\">sum</span>(<span class=\"number\">1</span> <span class=\"keyword\">for</span> c <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[r][c] == <span class=\"number\">1</span>)</span><br><span class=\"line\">    zeros = <span class=\"built_in\">sum</span>(<span class=\"number\">1</span> <span class=\"keyword\">for</span> c <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[r][c] == <span class=\"number\">0</span>)</span><br><span class=\"line\">    <span class=\"keyword\">return</span> ones, zeros</span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">count_col</span>(<span class=\"params\">c</span>):</span><br><span class=\"line\">    ones = <span class=\"built_in\">sum</span>(<span class=\"number\">1</span> <span class=\"keyword\">for</span> r <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[r][c] == <span class=\"number\">1</span>)</span><br><span class=\"line\">    zeros = <span class=\"built_in\">sum</span>(<span class=\"number\">1</span> <span class=\"keyword\">for</span> r <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[r][c] == <span class=\"number\">0</span>)</span><br><span class=\"line\">    <span class=\"keyword\">return</span> ones, zeros</span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">has_triple</span>(<span class=\"params\">r, c</span>):</span><br><span class=\"line\">    <span class=\"string\">&quot;&quot;&quot;检查在(r,c)附近是否出现连续三个相同颜色&quot;&quot;&quot;</span></span><br><span class=\"line\">    val = board[r][c]</span><br><span class=\"line\">    <span class=\"keyword\">if</span> val == -<span class=\"number\">1</span>:</span><br><span class=\"line\">        <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\">    <span class=\"comment\"># 检查行</span></span><br><span class=\"line\">    row = board[r]</span><br><span class=\"line\">    <span class=\"keyword\">for</span> j <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n - <span class=\"number\">2</span>):</span><br><span class=\"line\">        <span class=\"keyword\">if</span> row[j] == row[j+<span class=\"number\">1</span>] == row[j+<span class=\"number\">2</span>] == val:</span><br><span class=\"line\">            <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\">    <span class=\"comment\"># 检查列</span></span><br><span class=\"line\">    <span class=\"keyword\">for</span> i <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n - <span class=\"number\">2</span>):</span><br><span class=\"line\">        <span class=\"keyword\">if</span> board[i][c] == board[i+<span class=\"number\">1</span>][c] == board[i+<span class=\"number\">2</span>][c] == val:</span><br><span class=\"line\">            <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\">    <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">check_row_unique</span>():</span><br><span class=\"line\">    <span class=\"string\">&quot;&quot;&quot;已填满的行是否有重复&quot;&quot;&quot;</span></span><br><span class=\"line\">    seen = <span class=\"built_in\">set</span>()</span><br><span class=\"line\">    <span class=\"keyword\">for</span> r <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n):</span><br><span class=\"line\">        <span class=\"keyword\">if</span> -<span class=\"number\">1</span> <span class=\"keyword\">not</span> <span class=\"keyword\">in</span> board[r]:</span><br><span class=\"line\">            tup = <span class=\"built_in\">tuple</span>(board[r])</span><br><span class=\"line\">            <span class=\"keyword\">if</span> tup <span class=\"keyword\">in</span> seen:</span><br><span class=\"line\">                <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\">            seen.add(tup)</span><br><span class=\"line\">    <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">check_col_unique</span>():</span><br><span class=\"line\">    <span class=\"string\">&quot;&quot;&quot;已填满的列是否有重复&quot;&quot;&quot;</span></span><br><span class=\"line\">    seen = <span class=\"built_in\">set</span>()</span><br><span class=\"line\">    <span class=\"keyword\">for</span> c <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n):</span><br><span class=\"line\">        col = [board[r][c] <span class=\"keyword\">for</span> r <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n)]</span><br><span class=\"line\">        <span class=\"keyword\">if</span> -<span class=\"number\">1</span> <span class=\"keyword\">not</span> <span class=\"keyword\">in</span> col:</span><br><span class=\"line\">            tup = <span class=\"built_in\">tuple</span>(col)</span><br><span class=\"line\">            <span class=\"keyword\">if</span> tup <span class=\"keyword\">in</span> seen:</span><br><span class=\"line\">                <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\">            seen.add(tup)</span><br><span class=\"line\">    <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">dfs</span>(<span class=\"params\">idx</span>):</span><br><span class=\"line\">    <span class=\"keyword\">if</span> idx == <span class=\"built_in\">len</span>(empties):</span><br><span class=\"line\">        <span class=\"keyword\">return</span> check_row_unique() <span class=\"keyword\">and</span> check_col_unique()</span><br><span class=\"line\"></span><br><span class=\"line\">    r, c = empties[idx]</span><br><span class=\"line\">    <span class=\"comment\"># 数量剪枝准备</span></span><br><span class=\"line\">    row_ones, row_zeros = count_row(r)</span><br><span class=\"line\">    col_ones, col_zeros = count_col(c)</span><br><span class=\"line\"></span><br><span class=\"line\">    <span class=\"keyword\">for</span> val <span class=\"keyword\">in</span> (<span class=\"number\">0</span>, <span class=\"number\">1</span>):</span><br><span class=\"line\">        <span class=\"comment\"># 数量剪枝</span></span><br><span class=\"line\">        <span class=\"keyword\">if</span> val == <span class=\"number\">1</span> <span class=\"keyword\">and</span> row_ones == <span class=\"number\">3</span>:</span><br><span class=\"line\">            <span class=\"keyword\">continue</span></span><br><span class=\"line\">        <span class=\"keyword\">if</span> val == <span class=\"number\">0</span> <span class=\"keyword\">and</span> row_zeros == <span class=\"number\">3</span>:</span><br><span class=\"line\">            <span class=\"keyword\">continue</span></span><br><span class=\"line\">        <span class=\"keyword\">if</span> val == <span class=\"number\">1</span> <span class=\"keyword\">and</span> col_ones == <span class=\"number\">3</span>:</span><br><span class=\"line\">            <span class=\"keyword\">continue</span></span><br><span class=\"line\">        <span class=\"keyword\">if</span> val == <span class=\"number\">0</span> <span class=\"keyword\">and</span> col_zeros == <span class=\"number\">3</span>:</span><br><span class=\"line\">            <span class=\"keyword\">continue</span></span><br><span class=\"line\"></span><br><span class=\"line\">        board[r][c] = val</span><br><span class=\"line\">        <span class=\"keyword\">if</span> <span class=\"keyword\">not</span> has_triple(r, c):</span><br><span class=\"line\">            <span class=\"comment\"># 若行/列刚填满，可立即检查唯一性（剪枝）</span></span><br><span class=\"line\">            <span class=\"keyword\">if</span> -<span class=\"number\">1</span> <span class=\"keyword\">not</span> <span class=\"keyword\">in</span> board[r]:</span><br><span class=\"line\">                <span class=\"keyword\">if</span> <span class=\"keyword\">not</span> check_row_unique():</span><br><span class=\"line\">                    board[r][c] = -<span class=\"number\">1</span></span><br><span class=\"line\">                    <span class=\"keyword\">continue</span></span><br><span class=\"line\">                <span class=\"keyword\">if</span> <span class=\"built_in\">all</span>(board[i][c] != -<span class=\"number\">1</span> <span class=\"keyword\">for</span> i <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n)):</span><br><span class=\"line\">                    <span class=\"keyword\">if</span> <span class=\"keyword\">not</span> check_col_unique():</span><br><span class=\"line\">                        board[r][c] = -<span class=\"number\">1</span></span><br><span class=\"line\">                        <span class=\"keyword\">continue</span></span><br><span class=\"line\">                <span class=\"keyword\">if</span> dfs(idx + <span class=\"number\">1</span>):</span><br><span class=\"line\">                    <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\">            board[r][c] = -<span class=\"number\">1</span>   <span class=\"comment\"># 回溯</span></span><br><span class=\"line\">    <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\"></span><br><span class=\"line\">dfs(<span class=\"number\">0</span>)</span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"comment\"># 输出答案</span></span><br><span class=\"line\">ans = <span class=\"string\">&#x27;&#x27;</span>.join(<span class=\"built_in\">str</span>(board[i][j]) <span class=\"keyword\">for</span> i <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">for</span> j <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n))</span><br><span class=\"line\"><span class=\"built_in\">print</span>(ans)</span><br></pre></td></tr></table></figure>\n<h4 id=\"5-2-逐行解析\"><a href=\"#5-2-逐行解析\" class=\"headerlink\" title=\"5.2 逐行解析\"></a>5.2 逐行解析</h4><ul>\n<li><code>board</code>: 初始棋盘状态。</li>\n<li><code>n</code>: 棋盘大小（6x6）。</li>\n<li><code>empties</code>: 找到所有空格的位置。</li>\n<li><code>count_row</code> 和 <code>count_col</code>: 统计每行和每列的1和0的数量。</li>\n<li><code>has_triple</code>: 检查在某个位置附近是否有连续三个相同颜色的棋子。</li>\n<li><code>check_row_unique</code> 和 <code>check_col_unique</code>: 检查某行或某列是否已经填满且没有重复。</li>\n<li><code>dfs</code>: 深度优先搜索，尝试在每个空格落子，并进行剪枝。</li>\n</ul>\n<h4 id=\"5-3-优化技巧\"><a href=\"#5-3-优化技巧\" class=\"headerlink\" title=\"5.3 优化技巧\"></a>5.3 优化技巧</h4><ul>\n<li><strong>空间优化</strong>: 由于棋盘大小固定为6x6，可以直接使用数组而不是二维列表，减少空间开销。</li>\n<li><strong>时间优化</strong>: 通过预先计算每行每列的1和0的数量以及检查连续三个相同颜色的棋子，可以快速判断当前状态是否可行，减少不必要的搜索。</li>\n</ul>\n<h3 id=\"复杂度分析\"><a href=\"#复杂度分析\" class=\"headerlink\" title=\"复杂度分析\"></a>复杂度分析</h3><ul>\n<li><strong>时间复杂度</strong>: O(2^(n*n))，由于使用了DFS和回溯法进行剪枝。</li>\n<li><strong>空间复杂度</strong>: O(n^2)，用于存储棋盘状态和递归栈。</li>\n</ul>\n<h3 id=\"输入输出示例\"><a href=\"#输入输出示例\" class=\"headerlink\" title=\"输入输出示例\"></a>输入输出示例</h3><p><strong>样例输入</strong>:<br><figure class=\"highlight plaintext\"><table><tr><td class=\"gutter\"><pre><span class=\"line\">1</span><br><span class=\"line\">2</span><br><span class=\"line\">3</span><br><span class=\"line\">4</span><br><span class=\"line\">5</span><br><span class=\"line\">6</span><br><span class=\"line\">7</span><br><span class=\"line\">8</span><br></pre></td><td class=\"code\"><pre><span class=\"line\">[</span><br><span class=\"line\">    [1, 0, -1, 0, -1, -1],</span><br><span class=\"line\">    [-1, -1, -1, 0, -1, -1],</span><br><span class=\"line\">    [-1, -1, -1, -1, 0, 0],</span><br><span class=\"line\">    [-1, -1, -1, -1, -1, -1],</span><br><span class=\"line\">    [-1, -1, 1, -1, -1, 1],</span><br><span class=\"line\">    [-1, 0, -1, -1, 1, -1]</span><br><span class=\"line\">]</span><br></pre></td></tr></table></figure></p>\n<p><strong>样例输出</strong>:<br><figure class=\"highlight plaintext\"><table><tr><td class=\"gutter\"><pre><span class=\"line\">1</span><br></pre></td><td class=\"code\"><pre><span class=\"line\">101001010011101100010110011001100110</span><br></pre></td></tr></table></figure></p>\n<h3 id=\"常见错误与调试技巧\"><a href=\"#常见错误与调试技巧\" class=\"headerlink\" title=\"常见错误与调试技巧\"></a>常见错误与调试技巧</h3><p><strong>易错点</strong>: </p>\n<ul>\n<li>忽视了棋盘的初始化和空格的查找。</li>\n<li>在DFS过程中没有正确处理回溯。</li>\n</ul>\n<p><strong>调试方法</strong>: </p>\n<ul>\n<li>可以通过打印中间状态来跟踪算法的执行过程。</li>\n<li>使用断点调试来逐步检查代码的执行情况。</li>\n</ul>\n<p><strong>测试用例</strong>: </p>\n<ul>\n<li>使用已知结果的测试用例进行验证，确保算法的正确性。</li>\n</ul>\n<h3 id=\"总结与扩展\"><a href=\"#总结与扩展\" class=\"headerlink\" title=\"总结与扩展\"></a>总结与扩展</h3><p><strong>核心收获</strong>: </p>\n<ul>\n<li>学会使用DFS和回溯法解决组合逻辑问题。</li>\n<li>掌握如何通过剪枝优化算法的时间复杂度。</li>\n</ul>\n<p><strong>举一反三</strong>: </p>\n<ul>\n<li>类似的问题如井字棋、数独等也可以使用类似的算法解决。</li>\n</ul>\n<p><strong>进阶方向</strong>: </p>\n<ul>\n<li>可以进一步研究更高效的算法，如基于博弈论的策略分析。</li>\n</ul>\n","more":"<h2 id=\"洛谷-P12139-黑白棋-洛谷\"><a href=\"#洛谷-P12139-黑白棋-洛谷\" class=\"headerlink\" title=\"[洛谷 P12139] 黑白棋 - 洛谷\"></a>[洛谷 P12139] 黑白棋 - 洛谷</h2><h3 id=\"题目概览\"><a href=\"#题目概览\" class=\"headerlink\" title=\"题目概览\"></a>题目概览</h3><p><strong>题目来源</strong>: <a href=\"https://www.luogu.com.cn/problem/P12139\">洛谷</a></p>\n<p><strong>题目难度</strong>: ★★★★☆</p>\n<p><strong>标签分类</strong>: 算法标签、数据结构标签</p>\n<p><strong>核心考点</strong>: 二维数组操作、深度优先搜索（DFS）、回溯法</p>\n<h3 id=\"题意解析\"><a href=\"#题意解析\" class=\"headerlink\" title=\"题意解析\"></a>题意解析</h3><p>黑白棋是一种两人对弈的游戏，棋盘由黑白两种颜色组成。玩家轮流在空格处落子，每次只能落一个棋子，并且一旦落子就不能移动，只能吃掉对方的棋子。无法继续落子的玩家输掉游戏。题目要求判断当前棋盘状态是否能让玩家获胜。</p>\n<p><strong>输入格式</strong>: 一个6x6的二维数组，其中1表示黑子，0表示白子。</p>\n<p><strong>输出格式</strong>: 如果当前棋盘状态能赢，则输出”YES”；否则输出”NO”。</p>\n<p><strong>样例分析</strong>: 对于给定的棋盘状态，通过DFS和回溯法可以判断是否存在一种落子方式使得对手无法获胜，从而确定当前状态是否能赢。</p>\n<h3 id=\"算法思路\"><a href=\"#算法思路\" class=\"headerlink\" title=\"算法思路\"></a>算法思路</h3><h4 id=\"4-1-问题分析\"><a href=\"#4-1-问题分析\" class=\"headerlink\" title=\"4.1 问题分析\"></a>4.1 问题分析</h4><p>问题的本质是判断是否存在一种合法的落子方式，使得对手在接下来的回合无法获胜。关键观察点包括棋盘的当前状态、每行每列的1和0的数量以及是否存在连续三个相同颜色的棋子。</p>\n<h4 id=\"4-2-算法原理\"><a href=\"#4-2-算法原理\" class=\"headerlink\" title=\"4.2 算法原理\"></a>4.2 算法原理</h4><p><strong>朴素思路</strong>: 最直观的解法是遍历所有可能的落子方式，并检查每种方式下对手是否能赢。时间复杂度为O(2^(n*n))，空间复杂度为O(n^2)。</p>\n<p><strong>优化路径</strong>: 使用DFS和回溯法进行剪枝，减少不必要的搜索。通过预先计算每行每列的1和0的数量以及检查连续三个相同颜色的棋子，可以快速判断当前状态是否可行。</p>\n<p><strong>算法选择</strong>: DFS和回溯法适合解决这类问题，因为它可以系统地探索所有可能的解决方案，并通过剪枝减少搜索空间。</p>\n<p><strong>核心思想</strong>: 通过递归地尝试在每个空格落子，并在发现当前状态不可行时回溯，从而找到一种可行的落子方式。</p>\n<h4 id=\"4-3-数学推导\"><a href=\"#4-3-数学推导\" class=\"headerlink\" title=\"4.3 数学推导\"></a>4.3 数学推导</h4><p>由于黑白棋的规则较为简单，主要是基于组合逻辑，因此没有复杂的数学推导过程。</p>\n<h4 id=\"4-4-多种解法对比\"><a href=\"#4-4-多种解法对比\" class=\"headerlink\" title=\"4.4 多种解法对比\"></a>4.4 多种解法对比</h4><div class=\"table-container\">\n<table>\n<thead>\n<tr>\n<th>解法</th>\n<th>时间复杂度</th>\n<th>空间复杂度</th>\n<th>适用场景</th>\n<th>代码难度</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>DFS + 回溯</td>\n<td>O(2^(n*n))</td>\n<td>O(n^2)</td>\n<td>小规模数据</td>\n<td>中等</td>\n</tr>\n</tbody>\n</table>\n</div>\n<h3 id=\"代码详解\"><a href=\"#代码详解\" class=\"headerlink\" title=\"代码详解\"></a>代码详解</h3><h4 id=\"5-1-核心代码段\"><a href=\"#5-1-核心代码段\" class=\"headerlink\" title=\"5.1 核心代码段\"></a>5.1 核心代码段</h4><figure class=\"highlight python\"><table><tr><td class=\"gutter\"><pre><span class=\"line\">1</span><br><span class=\"line\">2</span><br><span class=\"line\">3</span><br><span class=\"line\">4</span><br><span class=\"line\">5</span><br><span class=\"line\">6</span><br><span class=\"line\">7</span><br><span class=\"line\">8</span><br><span class=\"line\">9</span><br><span class=\"line\">10</span><br><span class=\"line\">11</span><br><span class=\"line\">12</span><br><span class=\"line\">13</span><br><span class=\"line\">14</span><br><span class=\"line\">15</span><br><span class=\"line\">16</span><br><span class=\"line\">17</span><br><span class=\"line\">18</span><br><span class=\"line\">19</span><br><span class=\"line\">20</span><br><span class=\"line\">21</span><br><span class=\"line\">22</span><br><span class=\"line\">23</span><br><span class=\"line\">24</span><br><span class=\"line\">25</span><br><span class=\"line\">26</span><br><span class=\"line\">27</span><br><span class=\"line\">28</span><br><span class=\"line\">29</span><br><span class=\"line\">30</span><br><span class=\"line\">31</span><br><span class=\"line\">32</span><br><span class=\"line\">33</span><br><span class=\"line\">34</span><br><span class=\"line\">35</span><br><span class=\"line\">36</span><br><span class=\"line\">37</span><br><span class=\"line\">38</span><br><span class=\"line\">39</span><br><span class=\"line\">40</span><br><span class=\"line\">41</span><br><span class=\"line\">42</span><br><span class=\"line\">43</span><br><span class=\"line\">44</span><br><span class=\"line\">45</span><br><span class=\"line\">46</span><br><span class=\"line\">47</span><br><span class=\"line\">48</span><br><span class=\"line\">49</span><br><span class=\"line\">50</span><br><span class=\"line\">51</span><br><span class=\"line\">52</span><br><span class=\"line\">53</span><br><span class=\"line\">54</span><br><span class=\"line\">55</span><br><span class=\"line\">56</span><br><span class=\"line\">57</span><br><span class=\"line\">58</span><br><span class=\"line\">59</span><br><span class=\"line\">60</span><br><span class=\"line\">61</span><br><span class=\"line\">62</span><br><span class=\"line\">63</span><br><span class=\"line\">64</span><br><span class=\"line\">65</span><br><span class=\"line\">66</span><br><span class=\"line\">67</span><br><span class=\"line\">68</span><br><span class=\"line\">69</span><br><span class=\"line\">70</span><br><span class=\"line\">71</span><br><span class=\"line\">72</span><br><span class=\"line\">73</span><br><span class=\"line\">74</span><br><span class=\"line\">75</span><br><span class=\"line\">76</span><br><span class=\"line\">77</span><br><span class=\"line\">78</span><br><span class=\"line\">79</span><br><span class=\"line\">80</span><br><span class=\"line\">81</span><br><span class=\"line\">82</span><br><span class=\"line\">83</span><br><span class=\"line\">84</span><br><span class=\"line\">85</span><br><span class=\"line\">86</span><br><span class=\"line\">87</span><br><span class=\"line\">88</span><br><span class=\"line\">89</span><br><span class=\"line\">90</span><br><span class=\"line\">91</span><br><span class=\"line\">92</span><br><span class=\"line\">93</span><br><span class=\"line\">94</span><br><span class=\"line\">95</span><br><span class=\"line\">96</span><br><span class=\"line\">97</span><br><span class=\"line\">98</span><br><span class=\"line\">99</span><br><span class=\"line\">100</span><br><span class=\"line\">101</span><br><span class=\"line\">102</span><br><span class=\"line\">103</span><br></pre></td><td class=\"code\"><pre><span class=\"line\"><span class=\"comment\"># 初始棋盘 (-1 表示空)</span></span><br><span class=\"line\">board = [</span><br><span class=\"line\">    [<span class=\"number\">1</span>, <span class=\"number\">0</span>, -<span class=\"number\">1</span>, <span class=\"number\">0</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">0</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">0</span>, <span class=\"number\">0</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">1</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">1</span>],</span><br><span class=\"line\">    [-<span class=\"number\">1</span>, <span class=\"number\">0</span>, -<span class=\"number\">1</span>, -<span class=\"number\">1</span>, <span class=\"number\">1</span>, -<span class=\"number\">1</span>]</span><br><span class=\"line\">]</span><br><span class=\"line\"></span><br><span class=\"line\">n = <span class=\"number\">6</span></span><br><span class=\"line\">empties = [(i, j) <span class=\"keyword\">for</span> i <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">for</span> j <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[i][j] == -<span class=\"number\">1</span>]</span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">count_row</span>(<span class=\"params\">r</span>):</span><br><span class=\"line\">    ones = <span class=\"built_in\">sum</span>(<span class=\"number\">1</span> <span class=\"keyword\">for</span> c <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[r][c] == <span class=\"number\">1</span>)</span><br><span class=\"line\">    zeros = <span class=\"built_in\">sum</span>(<span class=\"number\">1</span> <span class=\"keyword\">for</span> c <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[r][c] == <span class=\"number\">0</span>)</span><br><span class=\"line\">    <span class=\"keyword\">return</span> ones, zeros</span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">count_col</span>(<span class=\"params\">c</span>):</span><br><span class=\"line\">    ones = <span class=\"built_in\">sum</span>(<span class=\"number\">1</span> <span class=\"keyword\">for</span> r <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[r][c] == <span class=\"number\">1</span>)</span><br><span class=\"line\">    zeros = <span class=\"built_in\">sum</span>(<span class=\"number\">1</span> <span class=\"keyword\">for</span> r <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">if</span> board[r][c] == <span class=\"number\">0</span>)</span><br><span class=\"line\">    <span class=\"keyword\">return</span> ones, zeros</span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">has_triple</span>(<span class=\"params\">r, c</span>):</span><br><span class=\"line\">    <span class=\"string\">&quot;&quot;&quot;检查在(r,c)附近是否出现连续三个相同颜色&quot;&quot;&quot;</span></span><br><span class=\"line\">    val = board[r][c]</span><br><span class=\"line\">    <span class=\"keyword\">if</span> val == -<span class=\"number\">1</span>:</span><br><span class=\"line\">        <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\">    <span class=\"comment\"># 检查行</span></span><br><span class=\"line\">    row = board[r]</span><br><span class=\"line\">    <span class=\"keyword\">for</span> j <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n - <span class=\"number\">2</span>):</span><br><span class=\"line\">        <span class=\"keyword\">if</span> row[j] == row[j+<span class=\"number\">1</span>] == row[j+<span class=\"number\">2</span>] == val:</span><br><span class=\"line\">            <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\">    <span class=\"comment\"># 检查列</span></span><br><span class=\"line\">    <span class=\"keyword\">for</span> i <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n - <span class=\"number\">2</span>):</span><br><span class=\"line\">        <span class=\"keyword\">if</span> board[i][c] == board[i+<span class=\"number\">1</span>][c] == board[i+<span class=\"number\">2</span>][c] == val:</span><br><span class=\"line\">            <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\">    <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">check_row_unique</span>():</span><br><span class=\"line\">    <span class=\"string\">&quot;&quot;&quot;已填满的行是否有重复&quot;&quot;&quot;</span></span><br><span class=\"line\">    seen = <span class=\"built_in\">set</span>()</span><br><span class=\"line\">    <span class=\"keyword\">for</span> r <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n):</span><br><span class=\"line\">        <span class=\"keyword\">if</span> -<span class=\"number\">1</span> <span class=\"keyword\">not</span> <span class=\"keyword\">in</span> board[r]:</span><br><span class=\"line\">            tup = <span class=\"built_in\">tuple</span>(board[r])</span><br><span class=\"line\">            <span class=\"keyword\">if</span> tup <span class=\"keyword\">in</span> seen:</span><br><span class=\"line\">                <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\">            seen.add(tup)</span><br><span class=\"line\">    <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">check_col_unique</span>():</span><br><span class=\"line\">    <span class=\"string\">&quot;&quot;&quot;已填满的列是否有重复&quot;&quot;&quot;</span></span><br><span class=\"line\">    seen = <span class=\"built_in\">set</span>()</span><br><span class=\"line\">    <span class=\"keyword\">for</span> c <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n):</span><br><span class=\"line\">        col = [board[r][c] <span class=\"keyword\">for</span> r <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n)]</span><br><span class=\"line\">        <span class=\"keyword\">if</span> -<span class=\"number\">1</span> <span class=\"keyword\">not</span> <span class=\"keyword\">in</span> col:</span><br><span class=\"line\">            tup = <span class=\"built_in\">tuple</span>(col)</span><br><span class=\"line\">            <span class=\"keyword\">if</span> tup <span class=\"keyword\">in</span> seen:</span><br><span class=\"line\">                <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\">            seen.add(tup)</span><br><span class=\"line\">    <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"keyword\">def</span> <span class=\"title function_\">dfs</span>(<span class=\"params\">idx</span>):</span><br><span class=\"line\">    <span class=\"keyword\">if</span> idx == <span class=\"built_in\">len</span>(empties):</span><br><span class=\"line\">        <span class=\"keyword\">return</span> check_row_unique() <span class=\"keyword\">and</span> check_col_unique()</span><br><span class=\"line\"></span><br><span class=\"line\">    r, c = empties[idx]</span><br><span class=\"line\">    <span class=\"comment\"># 数量剪枝准备</span></span><br><span class=\"line\">    row_ones, row_zeros = count_row(r)</span><br><span class=\"line\">    col_ones, col_zeros = count_col(c)</span><br><span class=\"line\"></span><br><span class=\"line\">    <span class=\"keyword\">for</span> val <span class=\"keyword\">in</span> (<span class=\"number\">0</span>, <span class=\"number\">1</span>):</span><br><span class=\"line\">        <span class=\"comment\"># 数量剪枝</span></span><br><span class=\"line\">        <span class=\"keyword\">if</span> val == <span class=\"number\">1</span> <span class=\"keyword\">and</span> row_ones == <span class=\"number\">3</span>:</span><br><span class=\"line\">            <span class=\"keyword\">continue</span></span><br><span class=\"line\">        <span class=\"keyword\">if</span> val == <span class=\"number\">0</span> <span class=\"keyword\">and</span> row_zeros == <span class=\"number\">3</span>:</span><br><span class=\"line\">            <span class=\"keyword\">continue</span></span><br><span class=\"line\">        <span class=\"keyword\">if</span> val == <span class=\"number\">1</span> <span class=\"keyword\">and</span> col_ones == <span class=\"number\">3</span>:</span><br><span class=\"line\">            <span class=\"keyword\">continue</span></span><br><span class=\"line\">        <span class=\"keyword\">if</span> val == <span class=\"number\">0</span> <span class=\"keyword\">and</span> col_zeros == <span class=\"number\">3</span>:</span><br><span class=\"line\">            <span class=\"keyword\">continue</span></span><br><span class=\"line\"></span><br><span class=\"line\">        board[r][c] = val</span><br><span class=\"line\">        <span class=\"keyword\">if</span> <span class=\"keyword\">not</span> has_triple(r, c):</span><br><span class=\"line\">            <span class=\"comment\"># 若行/列刚填满，可立即检查唯一性（剪枝）</span></span><br><span class=\"line\">            <span class=\"keyword\">if</span> -<span class=\"number\">1</span> <span class=\"keyword\">not</span> <span class=\"keyword\">in</span> board[r]:</span><br><span class=\"line\">                <span class=\"keyword\">if</span> <span class=\"keyword\">not</span> check_row_unique():</span><br><span class=\"line\">                    board[r][c] = -<span class=\"number\">1</span></span><br><span class=\"line\">                    <span class=\"keyword\">continue</span></span><br><span class=\"line\">                <span class=\"keyword\">if</span> <span class=\"built_in\">all</span>(board[i][c] != -<span class=\"number\">1</span> <span class=\"keyword\">for</span> i <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n)):</span><br><span class=\"line\">                    <span class=\"keyword\">if</span> <span class=\"keyword\">not</span> check_col_unique():</span><br><span class=\"line\">                        board[r][c] = -<span class=\"number\">1</span></span><br><span class=\"line\">                        <span class=\"keyword\">continue</span></span><br><span class=\"line\">                <span class=\"keyword\">if</span> dfs(idx + <span class=\"number\">1</span>):</span><br><span class=\"line\">                    <span class=\"keyword\">return</span> <span class=\"literal\">True</span></span><br><span class=\"line\">            board[r][c] = -<span class=\"number\">1</span>   <span class=\"comment\"># 回溯</span></span><br><span class=\"line\">    <span class=\"keyword\">return</span> <span class=\"literal\">False</span></span><br><span class=\"line\"></span><br><span class=\"line\">dfs(<span class=\"number\">0</span>)</span><br><span class=\"line\"></span><br><span class=\"line\"><span class=\"comment\"># 输出答案</span></span><br><span class=\"line\">ans = <span class=\"string\">&#x27;&#x27;</span>.join(<span class=\"built_in\">str</span>(board[i][j]) <span class=\"keyword\">for</span> i <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n) <span class=\"keyword\">for</span> j <span class=\"keyword\">in</span> <span class=\"built_in\">range</span>(n))</span><br><span class=\"line\"><span class=\"built_in\">print</span>(ans)</span><br></pre></td></tr></table></figure>\n<h4 id=\"5-2-逐行解析\"><a href=\"#5-2-逐行解析\" class=\"headerlink\" title=\"5.2 逐行解析\"></a>5.2 逐行解析</h4><ul>\n<li><code>board</code>: 初始棋盘状态。</li>\n<li><code>n</code>: 棋盘大小（6x6）。</li>\n<li><code>empties</code>: 找到所有空格的位置。</li>\n<li><code>count_row</code> 和 <code>count_col</code>: 统计每行和每列的1和0的数量。</li>\n<li><code>has_triple</code>: 检查在某个位置附近是否有连续三个相同颜色的棋子。</li>\n<li><code>check_row_unique</code> 和 <code>check_col_unique</code>: 检查某行或某列是否已经填满且没有重复。</li>\n<li><code>dfs</code>: 深度优先搜索，尝试在每个空格落子，并进行剪枝。</li>\n</ul>\n<h4 id=\"5-3-优化技巧\"><a href=\"#5-3-优化技巧\" class=\"headerlink\" title=\"5.3 优化技巧\"></a>5.3 优化技巧</h4><ul>\n<li><strong>空间优化</strong>: 由于棋盘大小固定为6x6，可以直接使用数组而不是二维列表，减少空间开销。</li>\n<li><strong>时间优化</strong>: 通过预先计算每行每列的1和0的数量以及检查连续三个相同颜色的棋子，可以快速判断当前状态是否可行，减少不必要的搜索。</li>\n</ul>\n<h3 id=\"复杂度分析\"><a href=\"#复杂度分析\" class=\"headerlink\" title=\"复杂度分析\"></a>复杂度分析</h3><ul>\n<li><strong>时间复杂度</strong>: O(2^(n*n))，由于使用了DFS和回溯法进行剪枝。</li>\n<li><strong>空间复杂度</strong>: O(n^2)，用于存储棋盘状态和递归栈。</li>\n</ul>\n<h3 id=\"输入输出示例\"><a href=\"#输入输出示例\" class=\"headerlink\" title=\"输入输出示例\"></a>输入输出示例</h3><p><strong>样例输入</strong>:<br><figure class=\"highlight plaintext\"><table><tr><td class=\"gutter\"><pre><span class=\"line\">1</span><br><span class=\"line\">2</span><br><span class=\"line\">3</span><br><span class=\"line\">4</span><br><span class=\"line\">5</span><br><span class=\"line\">6</span><br><span class=\"line\">7</span><br><span class=\"line\">8</span><br></pre></td><td class=\"code\"><pre><span class=\"line\">[</span><br><span class=\"line\">    [1, 0, -1, 0, -1, -1],</span><br><span class=\"line\">    [-1, -1, -1, 0, -1, -1],</span><br><span class=\"line\">    [-1, -1, -1, -1, 0, 0],</span><br><span class=\"line\">    [-1, -1, -1, -1, -1, -1],</span><br><span class=\"line\">    [-1, -1, 1, -1, -1, 1],</span><br><span class=\"line\">    [-1, 0, -1, -1, 1, -1]</span><br><span class=\"line\">]</span><br></pre></td></tr></table></figure></p>\n<p><strong>样例输出</strong>:<br><figure class=\"highlight plaintext\"><table><tr><td class=\"gutter\"><pre><span class=\"line\">1</span><br></pre></td><td class=\"code\"><pre><span class=\"line\">101001010011101100010110011001100110</span><br></pre></td></tr></table></figure></p>\n<h3 id=\"常见错误与调试技巧\"><a href=\"#常见错误与调试技巧\" class=\"headerlink\" title=\"常见错误与调试技巧\"></a>常见错误与调试技巧</h3><p><strong>易错点</strong>: </p>\n<ul>\n<li>忽视了棋盘的初始化和空格的查找。</li>\n<li>在DFS过程中没有正确处理回溯。</li>\n</ul>\n<p><strong>调试方法</strong>: </p>\n<ul>\n<li>可以通过打印中间状态来跟踪算法的执行过程。</li>\n<li>使用断点调试来逐步检查代码的执行情况。</li>\n</ul>\n<p><strong>测试用例</strong>: </p>\n<ul>\n<li>使用已知结果的测试用例进行验证，确保算法的正确性。</li>\n</ul>\n<h3 id=\"总结与扩展\"><a href=\"#总结与扩展\" class=\"headerlink\" title=\"总结与扩展\"></a>总结与扩展</h3><p><strong>核心收获</strong>: </p>\n<ul>\n<li>学会使用DFS和回溯法解决组合逻辑问题。</li>\n<li>掌握如何通过剪枝优化算法的时间复杂度。</li>\n</ul>\n<p><strong>举一反三</strong>: </p>\n<ul>\n<li>类似的问题如井字棋、数独等也可以使用类似的算法解决。</li>\n</ul>\n<p><strong>进阶方向</strong>: </p>\n<ul>\n<li>可以进一步研究更高效的算法，如基于博弈论的策略分析。</li>\n</ul>\n","categories":[],"tags":[{"name":"Python","path":"api/tags/Python.json"},{"name":"蓝桥杯","path":"api/tags/蓝桥杯.json"},{"name":"算法题解","path":"api/tags/算法题解.json"},{"name":"P12139","path":"api/tags/P12139.json"}]}